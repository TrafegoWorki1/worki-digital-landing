# Nomes das variaveis. Sem valor, como manda o AGENTS.md secao 5.
# Copie para .env e preencha localmente. O .env nao vai para o git.

# Numero de WhatsApp, com codigo do pais e DDD, so digitos.
# Exemplo: 5585999999999
# De onde vem o link que o lead ve depois de enviar o formulario.
WHATSAPP_NUMBER=

# Mensagem que abre a conversa no WhatsApp. Se vazio, usa o texto padrao.
WHATSAPP_MENSAGEM_FIXA=

# URL que recebe o cadastro em JSON. Vazio = o lead fica so no arquivo.
# Com webhook, o lead chega no seu sistema mesmo que o arquivo local
# se perca no reinicio do servidor.
WEBHOOK_URL=

# Cabecalho Authorization do webhook, no formato Bearer TOKEN.
# So preencha se o seu destino exigir autenticacao.
WEBHOOK_TOKEN=

# Pasta onde o lead e gravado quando nao ha webhook.
# Padrao: /tmp/worki-leads
LEADS_DIR=

# Analytics. Todos opcionais. Vazio = o evento nao e enviado para a
# ferramenta, mas continua registrado em window.__workiEventos.
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# Token publico da Conversion API do Meta.
# A chave secreta e outra coisa: ela fica no servidor e nunca no HTML.
META_CAPI_TOKEN_PUBLICO=